{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ sends each new glucose reading to your Pebble as soon as it arrives, and the watch buzzes when %1$@ raises a glucose alert." : {
      "comment" : "Pebble setup introduction (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sender hver nye glukosemåling til Pebble-klokken så snart den kommer, og klokken vibrerer når %1$@ gir et glukosevarsel."
          }
        }
      }
    },
    "%1$d (%2$d min total)" : {
      "comment" : "Pebble watch info: disconnect count and total minutes",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d (%2$d min totalt)"
          }
        }
      }
    },
    "%@ is ready for the watch" : {
      "comment" : "Pebble setup step: Bluetooth service published (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er klar for klokken"
          }
        }
      }
    },
    "%@ sends the next glucose reading as soon as it arrives. Tap Send Now to send the latest one." : {
      "comment" : "Pebble setup detail: connected, no reading yet (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sender neste glukosemåling så snart den kommer. Trykk på Send nå for å sende den siste."
          }
        }
      }
    },
    "%@ sends your readings and alerts to the Pebble over Bluetooth." : {
      "comment" : "Footer explaining the Pebble smartwatch device (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sender målingene og varslene dine til Pebble-klokken over Bluetooth."
          }
        }
      }
    },
    "%@ stops sending to the watch and removes the Pebble settings. You can add it again under Devices." : {
      "comment" : "Delete Pebble confirmation message (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slutter å sende til klokken og fjerner Pebble-innstillingene. Du kan legge den til igjen under Enheter."
          }
        }
      }
    },
    "%d ms" : {
      "comment" : "Pebble round trip in milliseconds (1: milliseconds)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d ms"
          }
        }
      }
    },
    "A large glucose ring with the reading time inside it, without graph, status line or last loop." : {
      "comment" : "Footer for the Pebble Large Glucose layout",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stor glukosering med målingstiden inni, uten graf, statuslinje eller siste loop."
          }
        }
      }
    },
    "A watch app for asking %1$@ to mute alerts, add carbs, use presets or give a bolus." : {
      "comment" : "Footer for the Luped Remote settings while it is off (1: app name)",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En klokkeapp for å be %1$@ om å dempe varsler, legge inn karbohydrater, bruke forhåndsinnstillinger eller gi en bolus."
          }
        }
      }
    },
