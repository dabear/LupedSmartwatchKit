    },
    "Pair a Core Devices Pebble Time 2 or Pebble Round 2 in the Pebble app. Older Pebbles can't run Luped CGM." : {
      "comment" : "Pebble setup checklist: pair a supported watch",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par en Pebble Time 2 eller Pebble Round 2 fra Core Devices i Pebble-appen. Eldre Pebble-klokker kan ikke kjøre Luped CGM."
          }
        }
      }
    },
    "Pebble" : {
      "comment" : "Title of the Pebble setup screen",
      "localizations" : {
